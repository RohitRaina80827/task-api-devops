pipeline {
  agent any
  options { timestamps(); buildDiscarder(logRotator(numToKeepStr: '10')) }
  environment { IMAGE_REPO = 'task-api' }
  stages {
    stage('Checkout Metadata') { steps {
      sh 'git rev-parse HEAD > evidence/ci-git-commit.txt'
      script { env.REVISION = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim() }
    }}
    stage('Test') { steps {
      sh 'python3 -m venv .ci-venv && . .ci-venv/bin/activate && pip install -r requirements-dev.txt && pytest -q'
    }}
    stage('Lint') { steps { sh '. .ci-venv/bin/activate && ruff check app tests' }}
    stage('Build') { steps {
      sh 'docker build --build-arg GIT_COMMIT=$REVISION -t $IMAGE_REPO:$REVISION .'
    }}
    stage('Inspect') { steps {
      sh 'docker image inspect $IMAGE_REPO:$REVISION --format "{{.Id}} {{index .Config.Labels \"org.opencontainers.image.revision\"}}" | tee evidence/ci-image-proof.txt'
    }}
    stage('Smoke Test') { steps {
      sh 'docker rm -f task-api-ci 2>/dev/null || true'
      sh 'docker run -d --name task-api-ci -p 18000:8000 --memory=384m $IMAGE_REPO:$REVISION'
      sh 'for i in $(seq 1 20); do curl -fsS http://127.0.0.1:18000/health/ready && exit 0; sleep 2; done; exit 1'
      sh 'curl -fsS http://127.0.0.1:18000/version | tee evidence/ci-runtime-version.json'
    }}
  }
  post {
    always { sh 'docker rm -f task-api-ci 2>/dev/null || true'; archiveArtifacts artifacts: 'evidence/ci-*', allowEmptyArchive: true }
  }
}